{
  "name": "opengreentrack",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japan-gx-group/OpenGreenTrack.git"
  },
  "homepage": "https://g-track.org",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "db:reset": "npx supabase db reset",
    "db:reset:demo": "npx supabase db reset --sql-paths \"./seeds/production/*.sql\" --sql-paths \"./seeds/demo/*.sql\"",
    "db:seed:demo": "node scripts/db/seed.ts demo",
    "db:seed:production": "node scripts/db/seed.ts production",
    "check:migrations": "node scripts/db/check-migrations.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.24.0",
    "next": "^16.3.4",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2"
  },
  "overrides": {
    "postcss": "^8.5.16",
    "sharp": "^0.35.4",
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@5": "^5.0.9",
    "js-yaml": "^5.2.3",
    "nanoid": "^3.3.18",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.16",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  }
}
